# =============================================================================
# AudiobookMaker — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.key

# ── Model weights & large files ───────────────────────────────────────────────
# HuggingFace cache
.cache/
*.bin
*.safetensors
*.ckpt
*.pt
*.pth
# XGBoost model (trained locally)
chapter_classifier.json

# ── Input books ───────────────────────────────────────────────────────────────
LOTM/

# ── Voice samples ─────────────────────────────────────────────────────────────
narrator_voice/
# Processed voices saved by the UI
audiobook_output/narrator_voice_processed.wav

# ── Generated audiobook output ────────────────────────────────────────────────
audiobook_output/

# ── Scratch / test data ───────────────────────────────────────────────────────
scratch/
test_narrator_voices/

# ── Debug / extraction output ─────────────────────────────────────────────────
debug_extraction_output/

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.swp
*~

# ── IDEs / agent workspaces ──────────────────────────────────────────────────
.vscode/
.idea/
.hermes/
*.sublime-project
*.sublime-workspace

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
!AudiobookMaker_Colab.ipynb
!program_testing.ipynb

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temp files ────────────────────────────────────────────────────────────────
tmp/
temp/
output/
results/
*.tmp
# Temp chapter processing dirs created by pipeline.py
abm_ch*/
# Benchmark test output
test_output_speed/
# Voice preprocessing cache
.voice_cache/
audiobook_factory/.voice_cache/
plan.md

# ── Rust ──────────────────────────────────────────────────────────────────────
audiobook_rust/target/
audiobook_rust/**/*.rs.bk
Cargo.lock
.cargo/

